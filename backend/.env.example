# AI Debate Arena - Environment Variables
APP_ENV=development
PORT=8000
SECRET_KEY=devil_advocate_super_secret_jwt_key_9992384729384729384
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration
# Supports OPENAI or GEMINI or MOCK (fallback for testing without keys)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# AWS Bedrock (Optional alternative)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Database
# If MongoDB is unavailable, system gracefully falls back to persistent local storage
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=debate_arena

# RAG & Embeddings
USE_CHROMA=true
CHROMA_PERSIST_DIR=./chroma_db
